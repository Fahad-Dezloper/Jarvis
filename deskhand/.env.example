# Jarvis needs no keys to run. Everything below is optional.
# Public URL used only for metadataBase. Leave empty locally.
SITE_URL=

# Optional public API endpoints (all free, no key required)
NEXT_PUBLIC_WEATHER_API_URL=https://wttr.in

# Music app: public Jamendo client ID (not a secret)
NEXT_PUBLIC_JAMENDO_CLIENT_ID=3dce8b55

# AI planner (server only; never expose to the browser). Without it the
# offline rules planner handles commands.
# Use ONE of these. Anthropic is used first if both are set, unless
# DESKHAND_PROVIDER=google (or anthropic) says otherwise.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DESKHAND_PROVIDER=
# Optional model override
DESKHAND_MODEL=

# Real web search for the Chrome/Safari apps (server only, all optional). First
# provider that is configured and answers wins; without any key Jarvis falls back
# to keyless sources (Wikipedia, Hacker News, Marginalia, arXiv).
# Google Programmable Search JSON API (real Google results, 100 queries/day free):
# Real Google results via Serper (https://serper.dev). Recommended.
SERPER_API_KEY=
# Google Programmable Search is closed to new customers; only works if you already have it.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Brave Search API key:
BRAVE_SEARCH_API_KEY=
